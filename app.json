{
  "expo": {
    "name": "MemoEZ",
    "slug": "memoez",
    "version": "0.1.5",
    "orientation": "portrait",
    "icon": "./assets/icon-easymemo.svg",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.memoez.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-easymemo.svg",
        "backgroundColor": "#ffffff"
      },
      "package": "com.memoez.app",
      "versionCode": 6,
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ]
    ],
    "scheme": "memoez",
    "experiments": {
      "typedRoutes": true
    }
  }
}
