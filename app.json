{
  "expo": {
    "name": "MemoEZ",
    "slug": "memoez",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.memoez.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#124B4B",
        "monochromeImage": "./assets/monochrome-icon.png"
      },
      "package": "com.memoez.app",
      "versionCode": 8,
      "softwareKeyboardLayoutMode": "pan"
    },
    "plugins": [
      "expo-router",
      "./modules/memoez-widget/plugin/withMemoEZWidget",
      [
        "expo-sqlite",
        {
          "enableFTS": true,
          "useSQLCipher": false
        }
      ],
      "./plugins/withAndroidBuild"
    ],
    "scheme": "memoez",
    "experiments": {
      "typedRoutes": true
    }
  }
}
