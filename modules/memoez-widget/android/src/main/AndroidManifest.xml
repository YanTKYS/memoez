<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <application>
    <!--
      ウィジェットから開くウィンドウ（FloatingEditorActivity / WidgetConfigActivity）は、
      Expo の ReactActivityDelegateWrapper を使うためアプリ側に生成し、config plugin
      （modules/memoez-widget/plugin/withMemoEZWidget.js）がアプリのマニフェストに登録する。
    -->
    <receiver
      android:name="expo.modules.memoezwidget.NoteWidgetProvider"
      android:label="@string/memoez_widget_label"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/memoez_widget_info" />
    </receiver>

    <!-- 4×2 一覧ウィジェット（表示するメモは自動。配置時の設定画面はない） -->
    <receiver
      android:name="expo.modules.memoezwidget.NoteListWidgetProvider"
      android:label="@string/memoez_list_widget_label"
      android:exported="true">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
      </intent-filter>
      <meta-data
        android:name="android.appwidget.provider"
        android:resource="@xml/memoez_widget_list_info" />
    </receiver>

    <!-- 一覧ウィジェットの行を供給する。ランチャー（システム）だけが接続できる -->
    <service
      android:name="expo.modules.memoezwidget.NoteListWidgetService"
      android:permission="android.permission.BIND_REMOTEVIEWS"
      android:exported="false" />
  </application>
</manifest>
