<?xml version="1.0" encoding="utf-8"?>
<!-- ウィジェット追加画面（Android 12+）に表示するプレビュー -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/memoez_widget_preview_bg"
    android:clipToOutline="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/memoez_widget_padding">

        <TextView
            style="@style/MemoEZWidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:maxLines="1"
            android:text="@string/memoez_widget_preview_title"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            style="@style/MemoEZWidgetText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="2dp"
            android:text="@string/memoez_widget_preview_body"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
