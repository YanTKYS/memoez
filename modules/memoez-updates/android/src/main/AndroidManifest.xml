<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
  <queries>
    <intent>
      <action android:name="android.intent.action.INSTALL_PACKAGE" />
      <data android:mimeType="application/vnd.android.package-archive" />
    </intent>
  </queries>
  <application>
    <provider android:name="expo.modules.memoezupdates.UpdateFileProvider"
      android:authorities="${applicationId}.updates"
      android:exported="false" android:grantUriPermissions="true">
      <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/memoez_update_paths" />
    </provider>
  </application>
</manifest>
